<!DOCTYPE html>
<html lang="sd" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ايڊمن پينل - گوگل ريويو پورٽل</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Noto Naskh Arabic', sans-serif; } </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen p-4">

    <div class="max-w-2xl mx-auto space-y-6">

        <!-- Admin Header -->
        <header class="bg-slate-900 text-white p-5 rounded-2xl flex justify-between items-center">
            <div>
                <h1 class="font-bold text-lg">ایڊمن پينل (Admin Control)</h1>
                <p id="admin-email" class="text-xs text-slate-400">چيڪ ٿي رهيو آهي...</p>
            </div>
            <button onclick="logout()" class="bg-red-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg">لاگ آئوٽ</button>
        </header>

        <!-- Create Task Section -->
        <div class="bg-white p-5 rounded-2xl border shadow-sm space-y-4">
            <h2 class="font-bold text-sm border-b pb-2 text-slate-700">➕ نئون ٽاسڪ ٺاهيو ۽ يوزر کي اسائن ڪريو</h2>
            
            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold mb-1">يوزر چونڊيو (Assigned User):</label>
                    <select id="user-select" class="w-full border p-2.5 rounded-xl bg-slate-50 outline-none">
                        <option value="">يوزرس لوڊ ٿي رهيا آهن...</option>
                    </select>
                </div>

                <div>
                    <label class="block font-semibold mb-1">Target Gmail (ان ايميل تان ريويو ڏيڻو آهي):</label>
                    <input type="email" id="target-gmail" placeholder="example@gmail.com" class="w-full border p-2.5 rounded-xl outline-none">
                </div>

                <div>
                    <label class="block font-semibold mb-1">Google Maps Link:</label>
                    <input type="url" id="maps-link" placeholder="https://maps.google.com/..." class="w-full border p-2.5 rounded-xl outline-none">
                </div>

                <div>
                    <label class="block font-semibold mb-1">ریويو ٽيڪسٽ (Review Text):</label>
                    <textarea id="review-text" rows="3" placeholder="ريويو جو ٽيڪسٽ لکو..." class="w-full border p-2.5 rounded-xl outline-none"></textarea>
                </div>

                <div>
                    <label class="block font-semibold mb-1">انعام / ريوارڊ (Reward PKR):</label>
                    <input type="number" id="reward-amount" value="50" class="w-full border p-2.5 rounded-xl outline-none">
                </div>

                <button onclick="createTask()" class="w-full bg-emerald-600 text-white font-bold py-2.5 rounded-xl text-xs">ٽاسڪ شامل ڪريو</button>
            </div>
        </div>

        <!-- Pending Submissions -->
        <div class="bg-white p-5 rounded-2xl border shadow-sm space-y-4">
            <h2 class="font-bold text-sm border-b pb-2 text-slate-700">📋 يوزرس جا موڪليل ثبوت (Submissions)</h2>
            <div id="submissions-list" class="space-y-3 text-xs"></div>
        </div>

    </div>

    <script>
    const SUPABASE_URL = 'https://hhywazbkgalioqqpuhyz.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhoeXdhemJrZ2FsaW9xcXB1aHl6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxNDkyNDAsImV4cCI6MjEwMzcyNTI0MH0.p4XMhb5rDPRp76sh6muWFi8oWU0hzkjKqUu_IZJFMTo';
    const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    async function checkAdmin() {
        const { data: { user } } = await _supabase.auth.getUser();
        if (!user) {
            alert("پهرين ايڊمن طور لاگ ان ٿيو!");
            window.location.href = "index.html";
            return;
        }

        const { data: profile } = await _supabase.from('profiles').select('is_admin').eq('id', user.id).single();
        if (!profile || !profile.is_admin) {
            alert("توهان وٽ ايڊمن جا اختيار ناهن!");
            window.location.href = "index.html";
            return;
        }

        document.getElementById('admin-email').innerText = user.email;
        loadUsers();
        loadSubmissions();
    }

    async function logout() {
        await _supabase.auth.signOut();
        window.location.href = "index.html";
    }

    async function loadUsers() {
        const { data: profiles } = await _supabase.from('profiles').select('id, email');
        const select = document.getElementById('user-select');
        select.innerHTML = '<option value="">-- يوزر منتخب ڪريو --</option>';
        if (profiles) {
            profiles.forEach(p => {
                select.innerHTML += `<option value="${p.id}">${p.email}</option>`;
            });
        }
    }

    async function createTask() {
        const userId = document.getElementById('user-select').value;
        const targetGmail = document.getElementById('target-gmail').value;
        const mapsLink = document.getElementById('maps-link').value;
        const reviewText = document.getElementById('review-text').value;
        const reward = document.getElementById('reward-amount').value;

        if (!userId || !mapsLink || !reviewText) {
            return alert("مهرباني ڪري سڀ معلومات داخل ڪريو!");
        }

        const { error } = await _supabase.from('tasks').insert([{
            assigned_user_id: userId,
            target_gmail: targetGmail,
            google_maps_link: mapsLink,
            review_text: reviewText,
            reward: parseFloat(reward),
            status: 'active'
        }]);

        if (!error) {
            alert("ٽاسڪ ڪاميابي سان مڪمل ٿيو!");
            document.getElementById('target-gmail').value = '';
            document.getElementById('maps-link').value = '';
            document.getElementById('review-text').value = '';
        } else {
            alert(error.message);
        }
    }

    async function loadSubmissions() {
        const { data: subs } = await _supabase.from('submissions')
            .select('*, tasks(*), profiles(*)')
            .eq('status', 'pending');

        const list = document.getElementById('submissions-list');
        list.innerHTML = '';

        if (subs && subs.length > 0) {
            subs.forEach(s => {
                list.innerHTML += `
                    <div class="border p-3 rounded-xl space-y-2 bg-slate-50">
                        <div class="flex justify-between font-bold text-slate-700">
                            <span>يوزر: ${s.profiles?.email || 'N/A'}</span>
                            <span class="text-emerald-600">Rs. ${s.tasks?.reward} PKR</span>
                        </div>
                        <p class="text-[11px] text-slate-500"><strong>Proof Link:</strong> <a href="${s.proof_link}" target="_blank" class="text-blue-600 underline">${s.proof_link}</a></p>
                        <div class="flex gap-2 pt-1">
                            <button onclick="approveSubmission(${s.id}, '${s.user_id}', ${s.tasks?.reward}, ${s.task_id})" class="bg-emerald-600 text-white px-3 py-1 rounded-lg font-bold">Approve</button>
                        </div>
                    </div>
                `;
            });
        } else {
            list.innerHTML = `<p class="text-slate-400 text-center py-4">ڪو به نئون پينڊنگ ثبوت ناهي.</p>`;
        }
    }

    async function approveSubmission(subId, userId, rewardAmount, taskId) {
        // 1. Mark submission approved
        await _supabase.from('submissions').update({ status: 'approved' }).eq('id', subId);
        // 2. Deactivate task
        await _supabase.from('tasks').update({ status: 'completed' }).eq('id', taskId);
        // 3. Update Balance
        const { data: prof } = await _supabase.from('profiles').select('balance').eq('id', userId).single();
        const newBal = (prof?.balance || 0) + rewardAmount;
        await _supabase.from('profiles').update({ balance: newBal }).eq('id', userId);

        alert("ثبوت اپروو ٿي ويو ۽ يوزر جي بيلنس ۾ پئسا شامل ٿي ويا!");
        loadSubmissions();
    }

    document.addEventListener('DOMContentLoaded', checkAdmin);
    </script>
</body>
</html>
